{
  "name": "jlc-openapi-cli",
  "version": "0.3.0",
  "description": "嘉立创开放平台命令行工具（JLC OpenAPI CLI）",
  "author": "xiongrucheng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuChengXiong/jlc-openapi-cli.git"
  },
  "homepage": "https://github.com/RuChengXiong/jlc-openapi-cli#readme",
  "bugs": {
    "url": "https://github.com/RuChengXiong/jlc-openapi-cli/issues"
  },
  "keywords": [
    "jlc",
    "jlcpcb",
    "openapi",
    "cli",
    "嘉立创"
  ],
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "jlc-openapi-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen:endpoints": "node scripts/gen-endpoints.mjs",
    "gen:check": "node scripts/gen-endpoints.mjs --check",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run gen:check && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
